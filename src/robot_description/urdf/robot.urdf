<?xml version="1.0"?>
<robot name="colmibot">
  <!-- X hacia el frente, Y hacia la izquierda y Z hacia arriba -->

  <link name="base_link">
    <inertial>
      <!-- COM e inercia del chasis transformados de CAD a ROS -->
      <origin xyz="0.0065838 -0.0009724 0.0376490" rpy="0 0 0" />
      <mass value="2.2407514" />
      <inertia
        ixx="0.0067021429" ixy="0.0000290305" ixz="-0.0009781756"
        iyy="0.0070338942" iyz="-0.0000546439"
        izz="0.0077199183" />
    </inertial>

    <visual>
      <!-- CAD: X lateral, Y vertical y Z longitudinal -->
      <origin xyz="0 0 0" rpy="1.57079632679 0 -1.57079632679" />
      <geometry>
        <mesh
          filename="package://robot_description/meshes/chasis.STL"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="chassis_gray">
        <color rgba="0.65 0.65 0.68 1" />
      </material>
    </visual>

    <!-- Colisión simplificada para no usar la malla visual densa -->
    <collision name="body_collision">
      <origin xyz="0 0 0.080" rpy="0 0 0" />
      <geometry>
        <box size="0.180 0.160 0.120" />
      </geometry>
    </collision>

    <!-- Los apoyos ya están incluidos en la masa y la malla del chasis -->
    <collision name="front_support_collision">
      <origin xyz="0.080 0 -0.0055625" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0079375" />
      </geometry>
    </collision>
    <collision name="rear_support_collision">
      <origin xyz="-0.080 0 -0.0055625" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0079375" />
      </geometry>
    </collision>
  </link>

  <link name="wheel_left_link">
    <inertial>
      <origin xyz="0.0000001 -0.0001772 0.0000031" rpy="0 0 0" />
      <mass value="0.0193581" />
      <inertia
        ixx="0.0000046755" ixy="0" ixz="0"
        iyy="0.0000091143" iyz="0"
        izz="0.0000046754" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_description/meshes/rueda_izquierda.STL"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="wheel_dark">
        <color rgba="0.12 0.12 0.12 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.030" length="0.006" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link" />
    <child link="wheel_left_link" />
    <origin xyz="0 0.0890475 0.0165" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="5.0" velocity="30.0" />
    <dynamics damping="0.05" friction="0.01" />
  </joint>

  <link name="wheel_right_link">
    <inertial>
      <origin xyz="0 0.0001772 0.0000031" rpy="0 0 0" />
      <mass value="0.0193581" />
      <inertia
        ixx="0.0000046755" ixy="0" ixz="0"
        iyy="0.0000091143" iyz="0"
        izz="0.0000046754" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_description/meshes/rueda_derecha.STL"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="wheel_dark" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.030" length="0.006" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link" />
    <child link="wheel_right_link" />
    <origin xyz="0 -0.0890475 0.0165" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="5.0" velocity="30.0" />
    <dynamics damping="0.05" friction="0.01" />
  </joint>

  <gazebo reference="base_link">
    <mu1>0.05</mu1>
    <mu2>0.05</mu2>
  </gazebo>
  <gazebo reference="wheel_left_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="wheel_right_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.178095</wheel_separation>
      <wheel_radius>0.030</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_velocity>0.60</max_linear_velocity>
      <max_angular_velocity>3.00</max_angular_velocity>
      <max_linear_acceleration>1.00</max_linear_acceleration>
      <max_angular_acceleration>4.00</max_angular_acceleration>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
